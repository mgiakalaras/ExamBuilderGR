<Window x:Class="ExamBuilderGR.Views.PreflightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExamBuilderGR.Models"
        Title="Προέλεγχος διαγωνίσματος" Height="650" Width="900"
        MinHeight="520" MinWidth="760" WindowStartupLocation="CenterOwner">
    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,15">
            <StackPanel>
                <TextBlock Text="Προέλεγχος πριν από εκτύπωση ή PDF" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Έλεγχος μονάδων, κενών πεδίων, απαντήσεων και δομής ερωτήσεων."
                           Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14">
            <Grid>
                <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Επιστροφή στον editor" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                    <Button Content="Συνέχεια" IsEnabled="{Binding CanProceed}" Click="Continue_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Αποτέλεσμα ελέγχου" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Τα σφάλματα πρέπει να διορθωθούν. Οι προειδοποιήσεις δεν εμποδίζουν την εκτύπωση."
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Padding="12,7" Margin="10,0" CornerRadius="6" Background="#33EF4444">
                        <TextBlock FontWeight="SemiBold"><Run Text="Σφάλματα: "/><Run Text="{Binding ErrorCount, Mode=OneWay}"/></TextBlock>
                    </Border>
                    <Border Grid.Column="2" Padding="12,7" CornerRadius="6" Background="#33F59E0B">
                        <TextBlock FontWeight="SemiBold"><Run Text="Προειδοποιήσεις: "/><Run Text="{Binding WarningCount, Mode=OneWay}"/></TextBlock>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="8">
                <ListBox ItemsSource="{Binding Issues}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:ValidationSeverity.Error}">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:ValidationSeverity.Warning}">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:ValidationSeverity.Information}">
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1" Margin="6,0,12,0">
                                        <TextBlock Text="{Binding SeverityLabel}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource MutedText}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </DockPanel>
</Window>
