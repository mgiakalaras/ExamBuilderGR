<Window x:Class="ExamBuilderGR.Views.SchoolSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ρυθμίσεις σχολείου" Height="820" Width="800"
        MinHeight="680" MinWidth="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Ρυθμίσεις σχολείου" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Τα στοιχεία και το λογότυπο χρησιμοποιούνται αυτόματα σε κάθε νέο διαγώνισμα."
                           Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Άκυρο" Click="Cancel_Click" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Αποθήκευση" Click="Save_Click" MinWidth="110"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource AppBackgroundBrush}">
            <StackPanel Margin="20" Background="{DynamicResource AppBackgroundBrush}">
                <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Στοιχεία σχολείου" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="Ονομασία σχολείου" Style="{StaticResource MutedText}"/>
                        <TextBox Text="{Binding Profile.SchoolName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>

                        <TextBlock Text="Υπότιτλος" Style="{StaticResource MutedText}"/>
                        <TextBox Text="{Binding Profile.SchoolSubtitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Διεύθυνση" Style="{StaticResource MutedText}"/>
                                <TextBox Text="{Binding Profile.Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,8,12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Τηλέφωνο" Style="{StaticResource MutedText}"/>
                                <TextBox Text="{Binding Profile.Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Email" Style="{StaticResource MutedText}"/>
                        <TextBox Text="{Binding Profile.Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Λογότυπο σχολείου" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Το αρχείο αντιγράφεται στον φάκελο της εφαρμογής, ώστε να μη χαθεί αν μετακινηθεί το αρχικό."
                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="164" Height="142" Background="White" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="8" VerticalAlignment="Top">
                                <Grid>
                                    <Image x:Name="SchoolLogoPreview" Stretch="Uniform"/>
                                    <TextBlock x:Name="NoLogoText" Text="Δεν έχει επιλεγεί λογότυπο"
                                               Foreground="#6B7280" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               MaxWidth="120"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Επιλογή εικόνας…" Click="SelectLogo_Click"/>
                                    <Button Content="Καθαρισμός" Click="ClearLogo_Click" Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>

                                <TextBlock x:Name="LogoPathTextBlock" Text="{Binding Profile.SchoolLogoPath}" Style="{StaticResource MutedText}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Profile.SchoolLogoPath}"
                                           Margin="4,0,0,12"/>

                                <CheckBox x:Name="ShowLogoCheckBox" Content="Εμφάνιση λογοτύπου στο διαγώνισμα και στο κλειδί λύσεων"
                                          IsChecked="{Binding Profile.ShowSchoolLogo}" Margin="4,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Θέση στην κεφαλίδα" Style="{StaticResource MutedText}"/>
                                        <ComboBox x:Name="LogoPositionComboBox"
                                                  SelectedItem="{Binding Profile.SchoolLogoPosition, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Πλάτος λογοτύπου" Style="{StaticResource MutedText}"/>
                                        <ComboBox x:Name="LogoWidthComboBox"
                                                  SelectedItem="{Binding Profile.SchoolLogoWidthCm, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,5,0,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat={}{0:0.0} cm}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="GrayscaleLogoCheckBox" Content="Ασπρόμαυρη εκτύπωση λογοτύπου"
                                          IsChecked="{Binding Profile.SchoolLogoGrayscale}"
                                          Checked="LogoPreviewOption_Changed" Unchecked="LogoPreviewOption_Changed" Margin="4,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Καθηγητής και σχολικό έτος" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ονοματεπώνυμο καθηγητή" Style="{StaticResource MutedText}"/>
                                <TextBox Text="{Binding Profile.TeacherName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,8,12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ειδικότητα" Style="{StaticResource MutedText}"/>
                                <TextBox Text="{Binding Profile.TeacherSpecialty, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Σχολικό έτος" Style="{StaticResource MutedText}"/>
                        <TextBox Text="{Binding Profile.SchoolYear, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Εμφάνιση" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="Προεπιλεγμένο χρωματικό θέμα" Style="{StaticResource MutedText}"/>
                        <ComboBox x:Name="ThemeComboBox" SelectedItem="{Binding Profile.ThemeName, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
