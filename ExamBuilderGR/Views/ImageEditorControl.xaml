<UserControl x:Class="ExamBuilderGR.Views.ImageEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ExamBuilderGR.Models"
             MinHeight="0">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
            Background="{DynamicResource PanelAltBackgroundBrush}" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Content="＋ Προσθήκη εικόνας"
                        Click="AddImage_Click" Style="{StaticResource SecondaryButton}"/>
                <StackPanel>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Οι εικόνες μπορούν να εμφανίζονται μόνες τους ή έως τέσσερις δίπλα στην ίδια σειρά."
                               Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Compact horizontal gallery: adding many images no longer creates a tall vertical list. -->
            <ListBox x:Name="ImagesList" Grid.Row="1"
                     ItemsSource="{Binding Images, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     SelectionChanged="ImagesList_SelectionChanged"
                     Margin="0,10,0,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Width" Value="178"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ExamImageAsset}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="116"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                    CornerRadius="5" Padding="5">
                                <Image Source="{Binding PreviewSource, Mode=OneWay}" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding FileName}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="2,6,2,0"/>
                            <TextBlock Grid.Row="2" Text="{Binding LayoutSummary, Mode=OneWay}"
                                       Style="{StaticResource MutedText}" FontSize="10.5" Margin="2,2,2,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Text="Δεν έχουν προστεθεί εικόνες."
                       FontStyle="Italic" Margin="0,10,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Images.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Only the selected image exposes its settings, keeping the editor compact. -->
            <Border Grid.Row="3" Margin="0,12,0,0" Padding="12" CornerRadius="7"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    DataContext="{Binding SelectedItem, ElementName=ImagesList}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="←" Padding="9,4" Style="{StaticResource SecondaryButton}"
                                    ToolTip="Μετακίνηση αριστερά / νωρίτερα" Click="MoveUp_Click"/>
                            <Button Content="→" Padding="9,4" Style="{StaticResource SecondaryButton}"
                                    ToolTip="Μετακίνηση δεξιά / αργότερα" Click="MoveDown_Click"/>
                            <Button Content="Διαγραφή" Padding="10,4" Style="{StaticResource DangerButton}"
                                    Click="DeleteImage_Click"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Ρυθμίσεις επιλεγμένης εικόνας" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Details, Mode=OneWay}" Style="{StaticResource MutedText}"
                                       FontSize="10.5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="105"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Θέση στο έγγραφο" Style="{StaticResource MutedText}"/>
                            <ComboBox ItemsSource="{Binding PlacementOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Placement}" Margin="0,4,8,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Διάταξη" Style="{StaticResource MutedText}"/>
                            <ComboBox ItemsSource="{Binding LayoutOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Layout}" Margin="0,4,8,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Αυτόματη αρίθμηση" Style="{StaticResource MutedText}"/>
                            <ComboBox ItemsSource="{Binding LabelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding LabelStyle}" Margin="0,4,8,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Πλάτος (cm)" Style="{StaticResource MutedText}"/>
                            <TextBox Text="{Binding WidthCm, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Λεζάντα (προαιρετική)" Style="{StaticResource MutedText}"/>
                            <TextBox Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Στοίχιση" Style="{StaticResource MutedText}"/>
                            <ComboBox ItemsSource="{Binding AlignmentOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Alignment}" Margin="0,4,8,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Layout}" Value="{x:Static models:ExamImageLayout.InlineRow}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Ομάδα σειράς" Style="{StaticResource MutedText}"/>
                            <TextBox Text="{Binding RowGroup, UpdateSourceTrigger=LostFocus}" Margin="0,4,8,0"
                                     ToolTip="Οι εικόνες με την ίδια ομάδα και θέση εμφανίζονται δίπλα."/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                            <CheckBox Content="Και στο κλειδί λύσεων" IsChecked="{Binding ShowInAnswerKey}" Margin="0,0,0,6"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Για εικόνες δίπλα-δίπλα: επίλεξε «Δίπλα στην ίδια σειρά» και βάλε τον ίδιο αριθμό ομάδας. Η εκτύπωση χωρά έως 4 εικόνες ανά σειρά."
                               Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,9,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
