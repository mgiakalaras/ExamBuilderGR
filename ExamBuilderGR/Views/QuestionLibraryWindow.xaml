<Window x:Class="ExamBuilderGR.Views.QuestionLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Βιβλιοθήκη ερωτήσεων" Height="720" Width="1060"
        MinHeight="580" MinWidth="900" WindowStartupLocation="CenterOwner">
    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Βιβλιοθήκη ερωτήσεων" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Αναζήτησε και πρόσθεσε έτοιμες ερωτήσεις στο τρέχον διαγώνισμα."
                               Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="Άνοιγμα φακέλου βιβλιοθήκης" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14">
            <Grid>
                <TextBlock x:Name="CountTextBlock" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Διαγραφή" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
                    <Button Content="Κλείσιμο" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                    <Button Content="Προσθήκη στο διαγώνισμα" Click="Use_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Αναζήτηση" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBox x:Name="SearchTextBox" Margin="0,5,12,0" TextChanged="SearchTextBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Μάθημα" Style="{StaticResource MutedText}" FontSize="11"/>
                        <ComboBox x:Name="SubjectFilterComboBox" Margin="0,5,12,0"
                                  SelectionChanged="FilterComboBox_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Τύπος ερώτησης" Style="{StaticResource MutedText}" FontSize="11"/>
                        <ComboBox x:Name="TypeFilterComboBox" Margin="0,5,0,0"
                                  SelectionChanged="FilterComboBox_SelectionChanged"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PanelBorder}" Padding="8" Margin="0,0,12,0">
                    <ListBox x:Name="QuestionsListBox" MouseDoubleClick="QuestionsListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="7,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}">
                                                <Run Text="{Binding Subject, Mode=OneWay}"/><Run Text=" · "/>
                                                <Run Text="{Binding Grade, Mode=OneWay}"/><Run Text=" · "/>
                                                <Run Text="{Binding TypeLabel, Mode=OneWay}"/><Run Text=" · "/>
                                                <Run Text="{Binding Question.Points, Mode=OneWay}"/><Run Text=" μ."/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Summary}" Margin="0,5,0,0" TextWrapping="Wrap"
                                                       MaxHeight="42" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy}}"
                                                   Margin="12,2,0,0" Style="{StaticResource MutedText}" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Πληροφορίες ερώτησης" FontWeight="SemiBold" FontSize="16"/>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="Κωδικός / Τύπος" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Margin="0,3,0,12">
                            <Run Text="{Binding SelectedItem.Question.Code, ElementName=QuestionsListBox, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding SelectedItem.TypeLabel, ElementName=QuestionsListBox, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="Μάθημα / Τάξη" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Margin="0,3,0,12">
                            <Run Text="{Binding SelectedItem.Subject, ElementName=QuestionsListBox, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding SelectedItem.Grade, ElementName=QuestionsListBox, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="Θέμα προέλευσης" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedItem.Category, ElementName=QuestionsListBox}" Margin="0,3,0,12"/>
                        <TextBlock Text="Εκφώνηση" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedItem.Question.Text, ElementName=QuestionsListBox}"
                                   Margin="0,3,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="Μονάδες" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedItem.Question.Points, ElementName=QuestionsListBox}"
                                   FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
