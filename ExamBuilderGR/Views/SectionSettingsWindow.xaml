<Window x:Class="ExamBuilderGR.Views.SectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ExamBuilderGR.Views"
        Title="Ρυθμίσεις θέματος" Height="560" Width="820" MinHeight="500" MinWidth="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Ρυθμίσεις θέματος" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="Τίτλος και κεντρική εκφώνηση που εμφανίζονται πριν από όλα τα υποερωτήματα."
                               Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7"
                        Padding="10,6" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="{Binding TotalPoints, Mode=OneWay}"/>
                        <Run Text=" μονάδες"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14">
            <Button Content="Κλείσιμο" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
                    MinWidth="110" Click="Close_Click"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18">
                <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Τίτλος θέματος" Style="{StaticResource EditorSectionTitle}"/>
                        <TextBlock Text="Παράδειγμα: ΘΕΜΑ Α" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,7"/>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Κεντρική εκφώνηση" Style="{StaticResource EditorSectionTitle}"/>
                        <TextBlock Text="Χρησιμοποίησέ την όταν όλα τα υποερωτήματα βασίζονται στο ίδιο κείμενο, πίνακα ή σενάριο."
                                   Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,8"/>
                        <TextBox Text="{Binding IntroText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="140" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorder}" Padding="14">
                    <TextBlock Text="Οι εικόνες του θέματος διαχειρίζονται πλέον από την κεντρική καρτέλα «Εικόνες» του κύριου παραθύρου."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
