<Window x:Class="ExamBuilderGR.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Σχετικά με το ExamBuilder GR" Height="500" Width="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Border Margin="24" Style="{StaticResource PanelBorder}" Padding="26">
            <StackPanel>
                <Border Width="92" Height="92" CornerRadius="16" Background="White" Padding="7"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Left">
                    <Image Source="/ExamBuilderGR;component/Assets/ExamBuilderGR_Icon_1024.png"
                           Stretch="Uniform" SnapsToDevicePixels="True"/>
                </Border>

                <TextBlock Text="{Binding ProductName}" FontSize="28" FontWeight="SemiBold" Margin="0,18,0,0"/>
                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,18"/>

                <Separator/>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Δημιουργός" Style="{StaticResource MutedText}" Margin="0,0,0,13"/>
                    <TextBlock Grid.Column="1" Text="{Binding Creator}" FontWeight="SemiBold" Margin="0,0,0,13"/>

                    <TextBlock Grid.Row="1" Text="Έτος ανάπτυξης" Style="{StaticResource MutedText}" Margin="0,0,0,13"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DevelopmentYear}" FontWeight="SemiBold" Margin="0,0,0,13"/>

                    <TextBlock Grid.Row="2" Text="Έκδοση εφαρμογής" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VersionText}" FontWeight="SemiBold"/>
                </Grid>

                <Border Margin="0,22,0,0" Padding="14" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="Η εφαρμογή δημιουργήθηκε για την οργάνωση και την ταχύτερη παραγωγή σχολικών διαγωνισμάτων, τεστ και κλειδιών λύσεων."
                               TextWrapping="Wrap"/>
                </Border>

                <Button Content="Κλείσιμο" HorizontalAlignment="Right" Margin="0,22,0,0" MinWidth="120" Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
