<Window x:Class="ExamBuilderGR.Views.TemplateNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Αποθήκευση ως πρότυπο" Height="390" Width="620"
        MinHeight="360" MinWidth="560" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Αποθήκευση ως πρότυπο" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Το πρότυπο θα κρατήσει τη δομή, τις ερωτήσεις και το προαιρετικό κλειδί λύσεων."
                           Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Άκυρο" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button Content="Αποθήκευση προτύπου" Click="Save_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource AppBackgroundBrush}">
            <Border Style="{StaticResource PanelBorder}" Padding="18" Margin="20">
                <StackPanel>
                    <TextBlock Text="Όνομα προτύπου" Style="{StaticResource MutedText}"/>
                    <TextBox x:Name="TemplateNameTextBox" Margin="0,6,0,16"/>

                    <TextBlock Text="Περιγραφή (προαιρετική)" Style="{StaticResource MutedText}"/>
                    <TextBox x:Name="DescriptionTextBox" Margin="0,6,0,0" MinHeight="110"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>

                    <TextBlock Text="Αν υπάρχει ήδη πρότυπο με το ίδιο όνομα, θα ενημερωθεί χωρίς να δημιουργηθεί δεύτερο αντίγραφο."
                               Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
