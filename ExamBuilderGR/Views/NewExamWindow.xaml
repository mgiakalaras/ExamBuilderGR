<Window x:Class="ExamBuilderGR.Views.NewExamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Νέο διαγώνισμα" Height="610" Width="690"
        MinHeight="560" MinWidth="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Δημιουργία νέου διαγωνίσματος" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Συμπλήρωσε τα βασικά στοιχεία. Μπορείς να τα αλλάξεις αργότερα από τον επεξεργαστή."
                           Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Άκυρο" Click="Cancel_Click" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Δημιουργία" Click="Create_Click" MinWidth="110"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource AppBackgroundBrush}">
            <StackPanel Margin="20" Background="{DynamicResource AppBackgroundBrush}">
                <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Τίτλος" Style="{StaticResource MutedText}"/>
                        <TextBox x:Name="TitleTextBox" Grid.Row="1" Text="Νέο διαγώνισμα" Margin="0,5,8,12"/>

                        <TextBlock Grid.Column="1" Text="Μάθημα" Style="{StaticResource MutedText}"/>
                        <TextBox x:Name="SubjectTextBox" Grid.Column="1" Grid.Row="1" Text="Πληροφορική" Margin="0,5,0,12"/>

                        <TextBlock Grid.Row="2" Text="Τάξη" Style="{StaticResource MutedText}"/>
                        <TextBox x:Name="GradeTextBox" Grid.Row="3" Text="Γ' Λυκείου" Margin="0,5,8,12"/>

                        <TextBlock Grid.Column="1" Grid.Row="2" Text="Τμήμα" Style="{StaticResource MutedText}"/>
                        <TextBox x:Name="ClassSectionTextBox" Grid.Column="1" Grid.Row="3" Margin="0,5,0,12"/>

                        <TextBlock Grid.Row="4" Text="Κατεύθυνση / Προσανατολισμός" Style="{StaticResource MutedText}"/>
                        <TextBox x:Name="OrientationTextBox" Grid.Row="5" Margin="0,5,8,0"/>

                        <TextBlock Grid.Column="1" Grid.Row="4" Text="Ημερομηνία" Style="{StaticResource MutedText}"/>
                        <DatePicker x:Name="ExamDatePicker" Grid.Column="1" Grid.Row="5" Margin="0,5,0,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PanelBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Αρχική δομή" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Η εφαρμογή θα δημιουργήσει τα θέματα και θα μοιράσει αυτόματα τις 100 μονάδες."
                                   Style="{StaticResource MutedText}" Margin="0,3,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Αριθμός θεμάτων" Style="{StaticResource MutedText}"/>
                                <ComboBox x:Name="SectionCountComboBox" Margin="0,5,8,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Διάρκεια σε λεπτά" Style="{StaticResource MutedText}"/>
                                <TextBox x:Name="DurationTextBox" Text="45" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="CreateQuestionsCheckBox" IsChecked="True" Margin="0,16,0,0"
                                  Content="Δημιουργία μίας αρχικής ερώτησης σε κάθε θέμα"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
