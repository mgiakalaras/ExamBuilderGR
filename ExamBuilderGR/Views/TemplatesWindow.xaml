<Window x:Class="ExamBuilderGR.Views.TemplatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Πρότυπα διαγωνισμάτων" Height="690" Width="980"
        MinHeight="560" MinWidth="820" WindowStartupLocation="CenterOwner">
    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Πρότυπα διαγωνισμάτων" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Δημιούργησε νέο διαγώνισμα από έτοιμη δομή χωρίς να αλλάξεις το αρχικό πρότυπο."
                               Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="Άνοιγμα φακέλου προτύπων" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14">
            <Grid>
                <TextBlock x:Name="CountTextBlock" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Διαγραφή" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
                    <Button Content="Κλείσιμο" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                    <Button Content="Χρήση προτύπου" Click="Use_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Αναζήτηση" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBox x:Name="SearchTextBox" Margin="0,5,12,0" TextChanged="SearchTextBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Μάθημα" Style="{StaticResource MutedText}" FontSize="11"/>
                        <ComboBox x:Name="SubjectFilterComboBox" Margin="0,5,0,0"
                                  SelectionChanged="SubjectFilterComboBox_SelectionChanged"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PanelBorder}" Padding="8" Margin="0,0,12,0">
                    <ListBox x:Name="TemplatesListBox" SelectionChanged="TemplatesListBox_SelectionChanged"
                             MouseDoubleClick="TemplatesListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                                       FontSize="11" Margin="0,4,0,0" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                   Style="{StaticResource MutedText}" FontSize="11" Margin="12,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Πληροφορίες προτύπου" FontWeight="SemiBold" FontSize="16"/>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="Όνομα" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedItem.Name, ElementName=TemplatesListBox}" FontWeight="SemiBold" Margin="0,3,0,12"/>
                        <TextBlock Text="Μάθημα / Τάξη" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Margin="0,3,0,12">
                            <Run Text="{Binding SelectedItem.Exam.Subject, ElementName=TemplatesListBox, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding SelectedItem.Exam.Grade, ElementName=TemplatesListBox, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="Δομή" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Margin="0,3,0,12">
                            <Run Text="{Binding SelectedItem.SectionCount, ElementName=TemplatesListBox, Mode=OneWay}"/>
                            <Run Text=" θέματα · "/>
                            <Run Text="{Binding SelectedItem.QuestionCount, ElementName=TemplatesListBox, Mode=OneWay}"/>
                            <Run Text=" ερωτήσεις"/>
                        </TextBlock>
                        <TextBlock Text="Περιγραφή" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedItem.Description, ElementName=TemplatesListBox}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
